# Buffer Personal API Key (from https://publish.buffer.com/settings/api)
BUFFER_API_KEY=your_buffer_token_here

# Google Gemini / Imagen API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Free ImgBB API Key for instant image hosting (from https://api.imgbb.com)
# If provided, generated images are uploaded automatically and attached to Buffer posts.
# If omitted, posts are published with text copy, and images are saved locally to disk.
IMGBB_API_KEY=your_imgbb_api_key_here

# Target services to publish to (comma-separated, e.g. facebook,linkedin,twitter)
# Leave blank to automatically publish to ALL connected channels in your Buffer account
BUFFER_TARGET_SERVICES=facebook,linkedin,twitter
